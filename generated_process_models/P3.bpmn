  <bpmn:process id="Process_1juweid" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Daily logs and indices registered" />
    <bpmn:exclusiveGateway id="Gateway_Scope" name="Scope of Assignment Verification" />
    <bpmn:endEvent id="EndEvent_Bypass" name="Process Exempt - Routine Shipboard" />
    <bpmn:serviceTask id="Task_IdentifyPAR" name="Identify Population at Risk (PAR)" camunda:type="expression" camunda:expression="${true}" />
    <bpmn:userTask id="Task_EstablishBaseline" name="Establish Medical Surveillance Baseline" />
    <bpmn:userTask id="Task_ConductSampling" name="Conduct OEH Sampling" />
    <bpmn:userTask id="Task_CollectForward" name="Collect and Forward Hazardous Material Samples" />
    <bpmn:serviceTask id="Task_DocumentExposures" name="Document Individual Exposures" camunda:type="expression" camunda:expression="${true}" />
    <bpmn:businessRuleTask id="Task_EvaluateDeviation" name="Evaluate Surveillance Baseline Deviation" />
    <bpmn:exclusiveGateway id="Gateway_Deviation" name="Surveillance Baseline Deviation Check" />
    <bpmn:userTask id="Task_ORM1_IdentifyHazards" name="Identify the Hazards" />
    <bpmn:userTask id="Task_ORM2_AssessRisks" name="Assess the Risks" />
    <bpmn:userTask id="Task_ORM3_AnalyzeControls" name="Analyze Risk Control Measures" />
    <bpmn:businessRuleTask id="Task_ORM4_MakeDecisions" name="Make Control Decisions" />
    <bpmn:userTask id="Task_ORM5_ImplementControls" name="Implement Risk Controls" />
    <bpmn:userTask id="Task_ORM6_SuperviseReview" name="Supervise and Review" />
    <bpmn:exclusiveGateway id="Gateway_Effectiveness" name="Evaluation of Risk Control Effectiveness" />
    <bpmn:serviceTask id="Task_Archive" name="Archive Surveillance Data" camunda:type="expression" camunda:expression="${true}" />
    <bpmn:endEvent id="EndEvent_Success" name="Aggregated health reports sent to Joint Force Surgeon" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_Scope" />
    <bpmn:sequenceFlow id="Flow_Bypass" name="Routine Shipboard" sourceRef="Gateway_Scope" targetRef="EndEvent_Bypass" />
    <bpmn:sequenceFlow id="Flow_Ashore" name="Ashore Field Operations" sourceRef="Gateway_Scope" targetRef="Task_IdentifyPAR" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_IdentifyPAR" targetRef="Task_EstablishBaseline" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_EstablishBaseline" targetRef="Task_ConductSampling" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ConductSampling" targetRef="Task_CollectForward" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CollectForward" targetRef="Task_DocumentExposures" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_DocumentExposures" targetRef="Task_EvaluateDeviation" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_EvaluateDeviation" targetRef="Gateway_Deviation" />
    <bpmn:sequenceFlow id="Flow_NoDeviation" name="No Deviation Detected" sourceRef="Gateway_Deviation" targetRef="Task_Archive" />
    <bpmn:sequenceFlow id="Flow_Deviation" name="Deviation Detected" sourceRef="Gateway_Deviation" targetRef="Task_ORM1_IdentifyHazards" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ORM1_IdentifyHazards" targetRef="Task_ORM2_AssessRisks" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ORM2_AssessRisks" targetRef="Task_ORM3_AnalyzeControls" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ORM3_AnalyzeControls" targetRef="Task_ORM4_MakeDecisions" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ORM4_MakeDecisions" targetRef="Task_ORM5_ImplementControls" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ORM5_ImplementControls" targetRef="Task_ORM6_SuperviseReview" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ORM6_SuperviseReview" targetRef="Gateway_Effectiveness" />
    <bpmn:sequenceFlow id="Flow_Ineffective" name="Controls Ineffective" sourceRef="Gateway_Effectiveness" targetRef="Task_ORM1_IdentifyHazards" />
    <bpmn:sequenceFlow id="Flow_Effective" name="Controls Effective" sourceRef="Gateway_Effectiveness" targetRef="Task_Archive" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Archive" targetRef="EndEvent_Success" />
  </bpmn:process>

