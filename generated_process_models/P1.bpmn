      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_To_ThreatCheck_di" bpmnElement="Flow_To_ThreatCheck">
        <di:waypoint x="218" y="180" />
        <di:waypoint x="270" y="180" />
      </bpmndi:BPMNEdge>
      
